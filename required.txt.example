# Reusable application answers

salary_expectation_chf_gross_per_year=90000
availability=immediately
linkedin_url=<your url>
github_url=<your url>
portfolio_url=<your url>
salutation_de=Herr
salutation_en=Mr
required_privacy_consent=yes

# Use the first option offered by the form, in this order.
referral_source_priority=Joblens,company website,LinkedIn

# Required free-text and screening answers may use only supported information from these
# sources. Leave the answer for manual review when neither source supports it.
answer_sources=CV,Arbeitszeugnisse
unsupported_answer_policy=manual_review

# Facts the ontology can name but must not guess (2026-08-28 corpus: each was a required
# select the form stayed partial on). Leave a key out to keep that field for review.
preferred_location=Zürich
correspondence_language=Deutsch
former_employee=no
criminal_or_debt_record=no
workload_percent_priority=100%,90%,80%
side_job=no
onsite_ok=yes

# Safety boundary
submit_applications=no
